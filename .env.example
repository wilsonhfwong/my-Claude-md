# Storage
DATABASE_URL=sqlite:///data/app.db
BLOB_STORE_ROOT=data/blobs

# Redis / ARQ
REDIS_URL=redis://localhost:6379/0

# LLM provider keys (fill in what you use)
DEFAULT_MODEL=anthropic/claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# SEC EDGAR — REQUIRED: replace with your contact email per EDGAR fair-access policy
EDGAR_USER_AGENT=FinSummary contact@example.com

# Audio API (Quartr or compatible)
AUDIO_PROVIDER=quartr
AUDIO_API_KEY=

# Agent loop policies
AGENT_COST_CAP_USD=50
AGENT_MAX_ITERATIONS_PER_WEEK=50
